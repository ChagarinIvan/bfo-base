{
    "private": true,
    "engines": {
        "node": ">=22",
        "npm": ">=10"
    },
    "scripts": {
        "dev": "npm run dev:spa",
        "dev:spa": "vite --config vite.config.ts",
        "build:spa": "vite build --config vite.config.ts",
        "lint": "eslint resources/spa --max-warnings=0 && prettier --check \"resources/spa/**/*.{ts,vue,html}\"",
        "typecheck": "vue-tsc --noEmit",
        "test": "vitest run",
        "ci": "npm run lint && npm run typecheck && npm run test && npm run build:spa"
    },
    "devDependencies": {
        "@typescript-eslint/parser": "^8.19.1",
        "@vitejs/plugin-vue": "^5.2.1",
        "@vue/test-utils": "^2.4.6",
        "axios": "^1.8.4",
        "eslint": "^9.17.0",
        "eslint-plugin-vue": "^10.1.0",
        "happy-dom": "^20.12.0",
        "prettier": "^3.4.2",
        "typescript": "^5.7.2",
        "typescript-eslint": "^8.19.1",
        "vite": "^6.0.5",
        "vitest": "^3.2.7",
        "vue": "^3.5.42",
        "vue-tsc": "^2.2.0"
    },
    "dependencies": {
        "@fortawesome/fontawesome-free": "^5.15.4",
        "@primevue/themes": "^4.2.5",
        "pinia": "^2.3.0",
        "primeicons": "^7.0.0",
        "primevue": "^4.2.5",
        "vue-router": "^4.5.0"
    }
}
