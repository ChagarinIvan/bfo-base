{
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "role": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20,
            "enum": [
                "architecture",
                "ddd",
                "security",
                "tests",
                "frontend",
                "uiux"
            ]
        },
        "baseSha": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "pattern": "^[a-f0-9]{40}$"
        },
        "headSha": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "pattern": "^[a-f0-9]{40}$"
        },
        "status": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20,
            "enum": ["completed", "not_applicable", "partial"]
        },
        "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
        },
        "limitations": {
            "type": "array",
            "maxItems": 8,
            "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
            }
        },
        "findings": {
            "type": "array",
            "maxItems": 12,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "priority": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2,
                        "enum": ["P0", "P1", "P2", "P3"]
                    },
                    "path": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 500
                    },
                    "startLine": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 10000000
                    },
                    "endLine": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 10000000
                    },
                    "title": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 160
                    },
                    "body": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2000
                    }
                },
                "required": [
                    "priority",
                    "path",
                    "startLine",
                    "endLine",
                    "title",
                    "body"
                ]
            }
        }
    },
    "required": [
        "role",
        "baseSha",
        "headSha",
        "status",
        "summary",
        "limitations",
        "findings"
    ]
}
